{
  "name": "robot-arm-simulator",
  "version": "0.9.0",
  "private": true,
  "description": "Browser-based six-axis robot arm simulator desktop application",
  "author": "Robot Arm Simulator Contributors",
  "productName": "AI Robot Arm Simulator",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test scripts/kinematics.test.mjs",
    "desktop": "electron .",
    "pack:dir": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.lyh.robotarmsimulator",
    "productName": "AI Robot Arm Simulator",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "LICENSE",
      "src/**/*",
      "assets/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/three/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/three/examples/jsm",
        "to": "three-examples",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Robot-Arm-Simulator-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Robot-Arm-Simulator-${version}-portable-${arch}.${ext}"
    }
  }
}
